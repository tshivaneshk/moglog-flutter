<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude SQLCipher encrypted databases & WAL/SHM files because the Android Keystore master key is hardware-bound -->
    <exclude domain="database" path="drama_db" />
    <exclude domain="database" path="drama_db-wal" />
    <exclude domain="database" path="drama_db-shm" />
    <exclude domain="database" path="drama_db-journal" />
    <exclude domain="root" path="app_flutter/drama_db_encrypted.db" />
    <exclude domain="root" path="app_flutter/drama_db_encrypted.db-wal" />
    <exclude domain="root" path="app_flutter/drama_db_encrypted.db-shm" />
    <exclude domain="root" path="app_flutter/drama_db_encrypted.db-journal" />

    <!-- Exclude Keystore-wrapped preferences & DataStore -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    <exclude domain="sharedpref" path="moglog_secure_store.xml" />
    <exclude domain="sharedpref" path="moglog_tink_keyset_prefs.xml" />
    <exclude domain="sharedpref" path="moglog_prefs.xml" />
    <exclude domain="file" path="datastore/moglog_settings.preferences_pb" />
</full-backup-content>
